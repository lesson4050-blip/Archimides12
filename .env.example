# ══════════════════════════════════════════════════════════
# Archimedes COSMO — Environment Configuration
# ══════════════════════════════════════════════════════════
#
# QUICKSTART: Copy this file to .env and fill in your API keys.
#   cp .env.example .env
#
# MINIMUM VIABLE CONFIG: You need ONLY these 2 keys to start:
#   1. GROQ_API_KEY  (or GOOGLE_API_KEY) — for LLM reasoning
#   2. TAVILY_API_KEY — for web search (optional but recommended)

ENVIRONMENT=development

# ── LLM API Keys (at least ONE required) ──────────────────
# Get free keys:
#   Groq:   https://console.groq.com/keys
#   Google: https://aistudio.google.com/apikey

GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=llama-3.3-70b-versatile

GOOGLE_API_KEY=your_google_key_here
GEMINI_MODEL=gemini-3.1-flash

# ── Search API Key (recommended) ──────────────────────────
# Without this, search falls back to DuckDuckGo (lower quality).
# Get a free key: https://tavily.com/

TAVILY_API_KEY=your_tavily_key_here
EXA_API_KEY=

# ── Ollama (local LLM, optional) ─────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:26b

# ── Sandbox ───────────────────────────────────────────────
SANDBOX_IMAGE=cosmo-sandbox:latest
SANDBOX_MAX_CONTAINERS=3
SANDBOX_INACTIVITY_TIMEOUT=1800

# ── Agent ─────────────────────────────────────────────────
AGENT_MAX_ITERATIONS=20
AGENT_MAX_CONTEXT_TOKENS=128000
CONTEXT_SUMMARIZATION_THRESHOLD=120000
CONTEXT_PRESERVE_RECENT=3
USE_MULTI_AGENT=true

# ── Database ──────────────────────────────────────────────
# PostgreSQL (production) or SQLite (auto-fallback in dev/test)
DATABASE_URL=postgresql+asyncpg://archimedes:archimedes@localhost:5432/archimedes
DATABASE_URL_SQLITE=sqlite+aiosqlite:///./archemidas.db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ── Redis (optional, enables distributed rate limiting) ───
REDIS_URL=

# ── Vector DB ─────────────────────────────────────────────
CHROMA_DB_PATH=./data/chroma_db
CHROMA_MAX_DOCS_PER_USER=10000
CHROMA_TTL_DAYS=90

# ── Auth / JWT ────────────────────────────────────────────
# CRITICAL: Generate a secure key for production!
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your_secret_key_here_min_32_chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
AUTH_ENABLED=false

# ── MCP (Model Context Protocol) ─────────────────────────
MCP_SERVER_PORT=8001
MCP_EXTERNAL_SERVERS=

# ── Email (optional) ─────────────────────────────────────
SENDER_EMAIL=your_email@gmail.com
SENDER_PASSWORD=your_app_password
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# ── Observability ─────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=admin
METRICS_BEARER_TOKEN=your_secure_metrics_token_here
AGENT_TASK_TIMEOUT=300
MAX_LLM_CALLS_PER_SESSION=200

# Set to true in production with multiple Uvicorn workers (requires Redis)
STRICT_RATE_LIMIT=false