# ═══════════════════════════════════════════
# Archimedes COSMO — Environment Configuration
# ═══════════════════════════════════════════

# LLM APIs (all free tier)
GROQ_API_KEY=your_groq_key_here
GOOGLE_API_KEY=your_google_key_here
TAVILY_API_KEY=your_tavily_key_here

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:26b

# Sandbox
SANDBOX_IMAGE=cosmo-sandbox:latest
SANDBOX_MAX_CONTAINERS=3
SANDBOX_INACTIVITY_TIMEOUT=1800

# Agent
AGENT_MAX_ITERATIONS=20
AGENT_MAX_CONTEXT_TOKENS=32768
CONTEXT_SUMMARIZATION_THRESHOLD=24000
CONTEXT_PRESERVE_RECENT=20
USE_MULTI_AGENT=false

# Database — PostgreSQL (production) or SQLite (dev fallback)
# Start PostgreSQL: docker-compose up -d
DATABASE_URL=postgresql+asyncpg://archimedes:archimedes@localhost:5432/archimedes
DATABASE_URL_SQLITE=sqlite+aiosqlite:///./archemidas.db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Auth / JWT
JWT_SECRET_KEY=your_secret_key_here_min_32_chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
AUTH_ENABLED=false

# MCP (Model Context Protocol)
MCP_SERVER_PORT=8001
MCP_EXTERNAL_SERVERS=

# Email (optional)
SENDER_EMAIL=your_email@gmail.com
SENDER_PASSWORD=your_app_password
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
